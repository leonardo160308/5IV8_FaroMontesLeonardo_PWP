<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cursos del circulo infernal</title>
</head>
<body>
    <main class="container">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre del curso</th>
                    <th>Descripcion</th>
                    <th>Docente</th>
                </tr>
            </thead>

            <% if (Array.isArray(cursos) && cursos.length > 0) { %>

            <tbody>
                <% cursos.forEach(curso => { %>
                    <tr>
                        <td><%= curso.id %></td>
                        <td><%= curso.nombre || '' %></td>
                        <td><%= curso.descripcion || '' %></td>
                        <td><%= curso.docente || '' %></td>
                    </tr>
                <% }); %>
            </tbody>

        </table>

        <% } else { %>
            <div>No hay cursos disponibles en este momento.</div>
            <p><a href="/">Volver a Bienvenida</a></p>
        <% } %>

    </main>
</body>
</html>
